# Gmail account that will send appointment notifications.
# For Gmail, use a Google App Password (not the normal account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=zparkar1@gmail.com
SMTP_PASS=YOUR_16_CHARACTER_GOOGLE_APP_PASSWORD

# Who receives booking notifications.
NOTIFY_EMAILS=aymanzakir28@gmail.com,zparkar1@gmail.com
MAIL_FROM_NAME=Zakir Parkar - Architectural Design

# Optional WhatsApp alerts via Twilio / WhatsApp Business Platform.
# Use the Twilio WhatsApp Sandbox while testing, or your approved production WhatsApp sender.
TWILIO_ACCOUNT_SID=YOUR_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN
WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+96892118458
# For production business-initiated messages, set an approved WhatsApp template Content SID.
# The template should contain one variable ({{1}}) for the full appointment detail.
WHATSAPP_CONTENT_SID=

# Optional admin key for future extensions / internal use.
ADMIN_KEY=change-this-to-a-long-random-string
PORT=3000
